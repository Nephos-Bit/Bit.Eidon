{
  "manifest_version": 3,
  "name": "Eidon",
  "version": "1.0.0",
  "description": "Schlägt auf Registrierungsformularen eine Wegwerfadresse vor und füllt das Formular aus. Abgesendet wird nur auf Wunsch.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "favicon"],
  "host_permissions": [
    "https://api.mail.tm/*",
    "https://api.mail.gw/*"
  ],
  "background": {
    "scripts": ["src/background/service-worker.js"],
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Eidon",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/eidon.png",
      "32": "icons/eidon.png",
      "48": "icons/eidon.png",
      "128": "icons/eidon.png"
    }
  },
  "icons": {
    "16": "icons/eidon.png",
    "32": "icons/eidon.png",
    "48": "icons/eidon.png",
    "128": "icons/eidon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/lib/form-kind.js", "src/content/toast-style.js", "src/content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "eidon@bit.extension",
      "strict_min_version": "128.0"
    }
  }
}
